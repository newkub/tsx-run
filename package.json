{
	"name": "tsx-run",
	"version": "0.1.0",
	"description": "Instant SolidJS SPA runner for TSX files — one file, one command, instant preview",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/newkub/tsx-run.git"
	},
	"homepage": "https://github.com/newkub/tsx-run#readme",
	"bin": {
		"tsx-run": "./src/cli.ts"
	},
	"files": [
		"src",
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"dev": "bun run src/cli.ts",
		"build": "bunx bunup",
		"build:watch": "bunx bunup --watch",
		"lint": "bun check",
		"test": "bun test",
		"tsx-run": "bun run src/cli.ts"
	},
	"dependencies": {
		"@iconify-json/lucide": "^1.2.105",
		"@iconify-json/mdi": "^1.2.3",
		"@unocss/preset-icons": "66.12.0",
		"@unocss/preset-wind4": "66.12.0",
		"cac": "^6.7.14",
		"picocolors": "^1.1.1",
		"unocss": "66.12.0",
		"vite": "^7.1.0",
		"vite-plugin-solid": "^2.11.16"
	},
	"devDependencies": {
		"@types/bun": "^1.3.0",
		"bunup": "^0.16.32",
		"typescript": "^5.9.0"
	},
	"engines": {
		"bun": ">=1.2.0"
	}
}
